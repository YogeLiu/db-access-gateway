HTTP_ADDR=:8080
CONTROL_MYSQL_PASSWORD=control-password
CONTROL_DSN=gateway:control-password@tcp(control-mysql:3306)/gateway?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
ADMIN_TOKEN=change-me-admin-token
TOKEN_PEPPER=change-me-token-pepper-at-least-32-characters
WEB_DIR=/app/web

# Add one pair for each account on each existing target MySQL database.
# The suffix must match the resource's read_secret_ref / write_secret_ref.
# These values are injected into the local Gateway container and are never
# returned through an API.
DB_SECRET_APP_PROD_READ=existing-app-read-password
DB_SECRET_APP_PROD_WRITE=existing-app-write-password
