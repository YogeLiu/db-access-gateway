HTTP_ADDR=:8080
CONTROL_MYSQL_PASSWORD=control-password
CONTROL_DSN=gateway:control-password@tcp(control-mysql:3306)/gateway?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
ADMIN_TOKEN=change-me-admin-token
TOKEN_PEPPER=change-me-token-pepper-at-least-32-characters
WEB_DIR=/app/web

# DNS resolvers used by Gateway to resolve target database hosts in Colima.
# Override these for a private or corporate DNS environment.
GATEWAY_DNS_1=100.100.100.100
GATEWAY_DNS_2=118.31.177.255

# New target database passwords are entered in the administration console and
# encrypted before they are stored in Control MySQL. DB_SECRET_* is retained
# only for resources migrated from the legacy secret_ref configuration.
