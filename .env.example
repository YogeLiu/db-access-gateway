HTTP_ADDR=:8080
CONTROL_MYSQL_PASSWORD=control-password
CONTROL_DSN=gateway:control-password@tcp(control-mysql:3306)/gateway?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
ADMIN_TOKEN=change-me-admin-token
TOKEN_PEPPER=change-me-token-pepper-at-least-32-characters
WEB_DIR=/app/web

# Credentials for accounts on existing target MySQL databases. They are
# referenced by database_resources.read_secret_ref / write_secret_ref and
# are never returned through an API.
DB_SECRET_PROD_READ=existing-target-read-password
DB_SECRET_PROD_WRITE=existing-target-write-password
