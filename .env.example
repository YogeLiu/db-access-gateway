HTTP_ADDR=:8080
CONTROL_DSN=gateway:gateway@tcp(control-mysql:3306)/gateway?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
ADMIN_TOKEN=change-me-admin-token
TOKEN_PEPPER=change-me-token-pepper-at-least-32-characters
WEB_DIR=/app/web

# Target credentials are referenced by database_resources.read_secret_ref /
# write_secret_ref. The service never returns these values through an API.
DB_SECRET_DEMO_READ=demo_read_password
DB_SECRET_DEMO_WRITE=demo_write_password
