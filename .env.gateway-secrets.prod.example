# Copy this file to .env.gateway-secrets.prod outside version control.
# Add one DB_SECRET_<REFERENCE> entry for each existing MySQL account.
# The reference suffix must match the resource's read_secret_ref or
# write_secret_ref after normalization to uppercase and underscores.

DB_SECRET_APP_PROD_READ=replace-with-app-read-password
DB_SECRET_APP_PROD_WRITE=replace-with-app-write-password

# Example for another existing database:
# DB_SECRET_ORDERS_PROD_READ=replace-with-orders-read-password
# DB_SECRET_ORDERS_PROD_WRITE=replace-with-orders-write-password
