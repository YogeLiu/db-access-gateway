# Copy this file to .env.gateway-secrets.prod outside version control.
# Add one DB_SECRET_<REFERENCE> entry for each existing MySQL resource.
# The reference suffix must match the resource's secret_ref after
# normalization to uppercase and underscores.

DB_SECRET_APP_PROD=replace-with-app-password

# Example for another existing database:
# DB_SECRET_ORDERS_PROD=replace-with-orders-password
