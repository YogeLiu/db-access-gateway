# Copy this file to .env.prod outside version control and replace every value.
# Use URL-safe values, for example: openssl rand -hex 32

CONTROL_MYSQL_ROOT_PASSWORD=replace-with-a-random-password
CONTROL_MYSQL_PASSWORD=replace-with-a-random-password
TARGET_MYSQL_ROOT_PASSWORD=replace-with-a-random-password

TARGET_READ_PASSWORD=replace-with-the-target-read-password
TARGET_WRITE_PASSWORD=replace-with-the-target-write-password

ADMIN_TOKEN=replace-with-at-least-20-random-characters
TOKEN_PEPPER=replace-with-at-least-32-random-characters
